# URL pública do app (sem barra final). Em dev: http://localhost:3000
APP_URL=http://localhost:3000

# Google OAuth (Console do Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth, tipo "Aplicativo da Web")
# URI de redirecionamento autorizado: ${APP_URL}/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domínio permitido. A checagem é feita no servidor sobre o id_token verificado.
ALLOWED_DOMAIN=bkm.com.br
# Exige claim hd (conta do Google Workspace do domínio). Só desligue se o domínio não usar Workspace.
REQUIRE_HD=true

# Segredo para assinar o cookie de sessão. Gere com: openssl rand -base64 48
SESSION_SECRET=

# Asaas: chave de PRODUÇÃO (a sandbox só conhece boletos criados na sandbox)
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3

# Neon (string de conexão com pooler)
DATABASE_URL=
